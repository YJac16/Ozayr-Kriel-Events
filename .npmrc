# Windows-specific npm configuration to prevent TAR_ENTRY_ERROR
# These settings address file locking, path length, and extraction issues

# CRITICAL: Reduce concurrency to prevent file locking conflicts during extraction
# This is the PRIMARY fix for TAR_ENTRY_ERROR on Windows
maxsockets=1

# Disable parallel installs to avoid race conditions with file system
# Windows file system doesn't handle concurrent writes well during tar extraction
prefer-offline=false

# Enable long paths (requires Windows 10+ and registry setting or group policy)
# This helps with deeply nested node_modules paths
# To enable: Run as Administrator:
# Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem" -Name "LongPathsEnabled" -Value 1
# Then restart your computer

# Ensure package-lock.json is always generated
package-lock=true

# Use legacy peer deps (already set globally, but explicit here)
legacy-peer-deps=true

# Reduce network timeouts to fail faster on bad connections
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Disable audit during install to reduce overhead and file operations
audit=false

# Disable funding messages to reduce output noise
fund=false

# Additional Windows-specific optimizations
# Use sequential file operations
progress=false
